# =============================================================================
# Suite server — configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and edit. Everything here is read at startup by
# src/config.js. To move to production you normally only touch a couple of
# lines (PORT, ALLOWED_ORIGINS, maybe DB_PATH) — the code never hardcodes any
# host or IP.
# =============================================================================

# Where the HTTP server listens.
# HOST=0.0.0.0 accepts connections from any interface (needed behind a proxy or
# in Docker). Use 127.0.0.1 to only accept local connections.
HOST=0.0.0.0
PORT=3000

# Runtime mode. "production" tightens error output.
NODE_ENV=development

# Path to the SQLite database file. It (and its folder) is created on boot.
# One DB backs the whole suite (rows are keyed by gameId).
# Point this at a persistent volume in production, e.g. /data/suite.db
DB_PATH=./data/suite.db

# CORS — which website origins may call this API from a browser.
# Comma-separated list of full origins, or "*" to allow any (fine for a public
# game, but list your real domains in production, e.g.:
#   ALLOWED_ORIGINS=https://games.example.com,https://quick-tap.example.com
ALLOWED_ORIGINS=*

# Safety limits.
# Max analytics events accepted in a single submission (protects the DB).
MAX_EVENTS=5000
# Max requests per IP per minute (simple in-memory throttle; 0 disables).
RATE_LIMIT_PER_MIN=120
# Max request-body size for admin data-import uploads (a whole event log in one
# request). Only the /api/admin/import routes use this; everything else is 2mb.
IMPORT_LIMIT=32mb

# Request logging (one line per request in the terminal running the server).
# LOG_REQUESTS=false silences it entirely. LOG_STATIC logs static-file hits
# (index.html, phaser.min.js, …) too — on by default since the bundle is only a
# couple of files per load; set false to see only the JSON API.
LOG_REQUESTS=true
LOG_STATIC=true

# Optionally let this server also host the games, so the whole suite is one
# deployment. Leave false if you host games separately (Netlify, S3, nginx…).
SERVE_STATIC=true

# Folder of built games to serve. Each immediate subfolder that has an index.html
# is served at /<subfolder>/, so one server hosts many games — each at its own URL.
# This is the repo's build output (dist/): game *source* lives in games/ and is
# bundled into dist/ by `npm run build`. On first run, if this folder is empty,
# every game in games/ is built into it automatically.
GAMES_DIR=../dist

# ---- Analytics dashboard (admin) --------------------------------------------
# The dashboard lives at /admin and needs an admin login. Manage accounts with
#   npm run admin -- add <username> <password>
# Or seed the FIRST admin here: if the admin table is empty on boot and both of
# these are set, that admin is created automatically. Leave blank once seeded.
ADMIN_USER=
ADMIN_PASSWORD=

# Admin session lifetime (days) and whether the session cookie is HTTPS-only.
# COOKIE_SECURE defaults to true in production; set false if TLS terminates
# elsewhere and you're testing over plain HTTP.
SESSION_DAYS=7
# COOKIE_SECURE=false
